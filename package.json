{
  "name": "arun_invoice",
  "version": "0.1.0",
  "private": true,
  "description": "TechGrah invoicing & billing — GST invoices, USD tax-free invoices, PDF, dashboard",
  "author": "TechGrah",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build:standalone": "cross-env BUILD_STANDALONE=1 next build && node scripts/prep-standalone.mjs",
    "electron:dev": "cross-env DESKTOP_APP=1 electron .",
    "desktop:icon": "node scripts/make-icon.mjs",
    "desktop:mac": "npm run desktop:icon && npm run build:standalone && electron-builder --mac"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.110.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "embedded-postgres": "17.10.0-beta.17",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.techgrah.invoicing",
    "productName": "TechGrah",
    "artifactName": "TechGrah-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": ".next/standalone", "to": "app", "filter": ["**/*", "!**/.env*"] },
      { "from": "prisma/migrations", "to": "migrations" }
    ],
    "asarUnpack": [
      "node_modules/embedded-postgres/**",
      "node_modules/@embedded-postgres/**"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "directories": { "output": "dist", "buildResources": "build" }
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true,
    "puppeteer@25.3.0": true
  }
}
