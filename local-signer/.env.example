# mock: signs with a throwaway software test cert (no hardware needed).
# pkcs11: signs with the real DSC via your Watchdata ProxKey USB token.
SIGNER_MODE=mock

# Origin of the deployed invoice app that's allowed to call this bridge.
# "*" is fine while testing locally; set to your real app URL once you're
# past that (e.g. https://your-app.vercel.app).
ALLOWED_ORIGIN=*

PORT=7734

# --- Only needed when SIGNER_MODE=pkcs11 ------------------------------------
# Path to Watchdata's PKCS#11 driver .dylib. See README.md "Finding your
# driver path" for how to locate this after installing the ProxKey driver.
# PKCS11_MODULE_PATH=/usr/local/lib/libwdpkcs11.dylib

# Optional: skip the interactive PIN prompt at startup. Leave unset to be
# prompted (recommended -- keeps the PIN out of any config file on disk).
# DSC_PIN=
