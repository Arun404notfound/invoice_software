# --- Database (Docker Compose / local Postgres defaults shown) -------------
POSTGRES_USER=techgrah
POSTGRES_PASSWORD=techgrah
POSTGRES_DB=techgrah_invoice
POSTGRES_PORT=5432
DATABASE_URL="postgresql://techgrah:techgrah@localhost:5432/techgrah_invoice?schema=public"

# --- Production database (Supabase) -----------------------------------------
# Leave unset for fully-local dev — prisma.config.ts falls back to
# DATABASE_URL when DIRECT_URL is absent, so nothing below is required
# until you're deploying against Supabase.
#
# DATABASE_URL should be Supabase's *pooled* connection string (port 6543,
# `?pgbouncer=true`) — used by the running app. DIRECT_URL is Supabase's
# *non-pooled* connection (port 5432) — used only by `prisma migrate`,
# since PgBouncer's transaction-pooling mode doesn't support what Migrate
# needs. Both are on your Supabase project's Database settings page.
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- File uploads (Supabase Storage) ----------------------------------------
# Leave unset for fully-local dev — the upload route falls back to writing
# to public/uploads/ on disk when these aren't set. Required in production
# (Vercel's filesystem isn't persistent). From your Supabase project's
# API settings; SUPABASE_SERVICE_ROLE_KEY bypasses RLS for server-side
# writes to a public "uploads" storage bucket you create once.
# SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=

# --- Session cookie ----------------------------------------------------------
# Any random 32+ char string. Used to namespace/sign session cookies.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Seeded admin user (used by `npm run db:seed` and POST /api/setup) -----
ADMIN_EMAIL="founder@techgrah.com"
ADMIN_NAME="TechGrah Founder"
ADMIN_PASSWORD="ChangeThisPassword123!"

# --- One-time production bootstrap ------------------------------------------
# Set this in Vercel only. After your first deploy, call:
#   curl -X POST https://your-app.vercel.app/api/setup -H "x-setup-secret: <this value>"
# to create the admin user + starter business profile without needing local
# database access. Safe to call more than once (idempotent); remove the env
# var afterward if you'd rather not leave the endpoint reachable.
# SETUP_SECRET="replace-with-a-long-random-string"

# --- App -----------------------------------------------------------------
# Used to build the public share link embedded in send emails — set to
# your real deployed URL in production (e.g. https://your-app.vercel.app).
APP_URL="http://localhost:3000"

# --- Email (SMTP, provider-agnostic) ----------------------------------------
# Leave unset to have Send log the email to the console instead of
# delivering it (safe for local dev/testing). Any standard SMTP provider
# works — Gmail with an app password, Brevo, Zoho, SES, etc.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="TechGrah Innovations <billing@techgrah.com>"

# --- Razorpay — wired up in a later phase -----------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
